{
  "name": "new-content-alert",
  "version": "1.0.0",
  "description": "Cloudflare Worker that watches RBI, IRDAI and NPCI for newly published regulatory items and alerts on new ones (change detection; title + link only).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "node-html-parser": "^6.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
